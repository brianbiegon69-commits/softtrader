# Copy this file to .env and fill in your values. Never commit .env.

PORT=3000
NODE_ENV=development

# Your Deriv app ID (register one at https://api.deriv.com/dashboard)
# Its OAuth redirect URL there must be exactly: https://YOUR-DOMAIN/auth/callback
DERIV_APP_ID=

# Where the "Sign up" button sends people (add your affiliate/partner link if you have one)
DERIV_SIGNUP_URL=https://deriv.com/signup/

# A long random string used to encrypt login cookies (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: pin the callback URL (must match the redirect URL registered on Deriv exactly).
REDIRECT_URI=
